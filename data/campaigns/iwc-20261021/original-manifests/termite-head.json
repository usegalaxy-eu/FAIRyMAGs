{
  "schema_version": 2,
  "galaxy_url": "https://usegalaxy.eu",
  "use_case": "termite-head",
  "history_tags": [
    "FAIRyMAGs",
    "publication",
    "termite-use-case"
  ],
  "exclude_history_tags": [
    "fail",
    "rerun"
  ],
  "execution": {
    "new_history_only": true,
    "on_failure": "continue",
    "use_cached_job": true,
    "poll_interval_seconds": 30
  },
  "sources": {
    "raw_reads": {
      "history": {
        "name": "Termite Head Microbiome",
        "tags": [
          "FAIRyMAGs",
          "publication",
          "termite-use-case",
          "Input"
        ]
      },
      "content": {
        "name": "input_reads",
        "type": "collection"
      }
    },
    "cryptotermes_reference": {
      "history": {
        "name": "Termite_head_microbiome extra files",
        "tags": [
          "FAIRyMAGs",
          "publication",
          "termite-use-case",
          "Input"
        ]
      },
      "content": {
        "name": "GCA_977948025.2_Csec_1.0_genomic.fna",
        "type": "dataset"
      }
    },
    "cdom_reference": {
      "history": {
        "name": "Termite_head_microbiome extra files",
        "tags": [
          "FAIRyMAGs",
          "publication",
          "termite-use-case",
          "Input"
        ]
      },
      "content": {
        "name": "Cdom_clean.fasta",
        "type": "dataset"
      }
    },
    "grouped_reads": {
      "history": {
        "name": "Sample Grouping",
        "tags": [
          "FAIRyMAGs",
          "publication",
          "termite-use-case"
        ]
      },
      "content": {
        "name": "Fastq groupmerge on dataset 116 and collection 114: Merged samples (pairs)",
        "type": "collection",
        "tags": [
          "Reads"
        ]
      }
    }
  },
  "steps": [
    {
      "name": "quality_control",
      "workflow": {
        "name": "Short-read quality control and trimming",
        "link": "https://usegalaxy.eu/workflows/run?id=e80aa9c8f974e1c8",
        "tags": [
          "publication"
        ]
      },
      "output_history": {
        "name": "Short-read quality control and trimming"
      },
      "inputs": {
        "Raw reads": "source:raw_reads"
      },
      "parameters": {
        "Adapter to remove on forward reads": null,
        "Adapter to remove on reverse reads": null,
        "Qualified quality score": "15",
        "Minimal read length": "15"
      }
    },
    {
      "name": "remove_cryptotermes",
      "workflow": {
        "name": "Host or Contamination Removal on Short-Reads",
        "link": "https://usegalaxy.eu/workflows/run?id=70734f51140046aa",
        "tags": [
          "publication"
        ]
      },
      "output_history": {
        "name": "Host or Contamination Removal on Short-Reads (Cryptotermes secundus isolate)"
      },
      "inputs": {
        "Short-reads": {
          "step": "quality_control",
          "content": {
            "name": "Trimmed reads",
            "type": "collection",
            "tags": [
              "Reads"
            ]
          }
        },
        "Reference genome file": "source:cryptotermes_reference"
      },
      "parameters": {
        "Choose Reference Genome": "Use a reference genome from the history",
        "Host/Contaminant Reference Genome": "apiMel3"
      }
    },
    {
      "name": "remove_cdom",
      "workflow": {
        "name": "Host or Contamination Removal on Short-Reads",
        "link": "https://usegalaxy.eu/workflows/run?id=70734f51140046aa",
        "tags": [
          "publication"
        ]
      },
      "output_history": {
        "name": "Host or Contamination Removal on Short-Reads (Cdom)"
      },
      "inputs": {
        "Short-reads": {
          "step": "remove_cryptotermes",
          "content": {
            "name": "Reads without host or contaminant reads",
            "type": "collection",
            "tags": [
              "Reads"
            ]
          }
        },
        "Reference genome file": "source:cdom_reference"
      },
      "parameters": {
        "Choose Reference Genome": "Use a reference genome from the history",
        "Host/Contaminant Reference Genome": "apiMel3"
      }
    },
    {
      "name": "mags",
      "workflow": {
        "name": "Metagenome-Assembled Genomes (MAGs) generation",
        "link": "https://usegalaxy.eu/workflows/run?id=d1e5b1146ad6fd1a",
        "tags": [
          "publication"
        ]
      },
      "output_history": {
        "name": "Metagenome-Assembled Genomes (MAGs) generation"
      },
      "inputs": {
        "Trimmed paired reads from grouped samples": "source:grouped_reads",
        "Trimmed reads": {
          "step": "remove_cdom",
          "content": {
            "name": "Reads without host or contaminant reads",
            "type": "collection",
            "tags": [
              "Reads"
            ]
          }
        }
      },
      "parameters": {
        "Choose Assembler": "MEGAHIT",
        "Minimum length of contigs to output": "500",
        "Environment for the built-in model (SemiBin)": "global",
        "Run COMEBin": true,
        "Minimum MAG completeness percentage": "0",
        "Contamination weight (Binette)": "2",
        "Read length (CONCOCT)": "150",
        "CheckM2 Database": "1.0.2",
        "Minimum MAG length": "50000",
        "Maximum MAG contamination percentage": "100",
        "ANI threshold for dereplication": "0.95"
      }
    },
    {
      "name": "taxonomy",
      "workflow": {
        "name": "MAGs taxonomy annotation",
        "link": "https://usegalaxy.eu/workflows/run?id=5cfde61f7465cc81",
        "tags": [
          "publication"
        ]
      },
      "output_history": {
        "name": "MAGs taxonomy annotation"
      },
      "inputs": {
        "Sequence collection": {
          "step": "mags",
          "content": {
            "name": "dereplicated_genomes",
            "type": "collection",
            "tags": [
              "Dereplicated-Bins"
            ]
          }
        }
      },
      "parameters": {
        "GTDB-Tk Database": "full_database_release_226_downloaded_2026-02-25",
        "MAGs taxonomic classification with kMetaShot (optional)": true,
        "kMetaShot Database": "2025-05-22",
        "ass2ref for kMS": "0.0"
      }
    },
    {
      "name": "genome_annotation",
      "workflow": {
        "name": "MAG Genome Annotation Parallel",
        "link": "https://usegalaxy.eu/workflows/run?id=4d2db479f36df9cc",
        "tags": [
          "publication"
        ]
      },
      "output_history": {
        "name": "MAG Genome Annotation Parallel"
      },
      "inputs": {
        "Bacterial Genomes": {
          "step": "mags",
          "content": {
            "name": "dereplicated_genomes",
            "type": "collection",
            "tags": [
              "Dereplicated-Bins"
            ]
          }
        }
      },
      "parameters": {
        "Plasmid detection database": "plasmidfinder_81c11f4_2023_12_04",
        "Bacterial genome annotation database": "V5.1_2024-01-19",
        "AMRFinderPlus database": "amrfinderplus_V3.12_2024-05-02.2",
        "Run Bakta": true
      }
    },
    {
      "name": "functional_annotation",
      "workflow": {
        "name": "Functional annotation of sequences",
        "link": "https://usegalaxy.eu/workflows/run?id=efd1cb45f0c4ff98",
        "tags": [
          "publication"
        ]
      },
      "output_history": {
        "name": "Functional annotation of sequences"
      },
      "inputs": {
        "Sequence collection": {
          "step": "mags",
          "content": {
            "name": "dereplicated_genomes",
            "type": "collection",
            "tags": [
              "Dereplicated-Bins"
            ]
          }
        }
      },
      "parameters": {
        "Run eggNOG + completeness calculation": true,
        "eggNOG mode select": "metagenome",
        "Run InterProScan": true,
        "InterProScan mode select": "DNA/RNA"
      }
    }
  ]
}
